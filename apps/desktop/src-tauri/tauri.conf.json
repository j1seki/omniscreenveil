{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniScreenVeil",
  "version": "0.1.4",
  "identifier": "io.github.j1seki.omniscreenveil",
  "build": {
    "beforeDevCommand": "pnpm build:hook && pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build:hook && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OmniScreenVeil",
        "width": 1180,
        "height": 800,
        "minWidth": 940,
        "minHeight": 640,
        "center": true,
        "devtools": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["appimage", "deb", "nsis", "dmg"],
    "category": "Utility",
    "shortDescription": "Selective screen-capture privacy",
    "longDescription": "Share a dedicated Veil Surface that filters or masks selected windows. OS-level capture exclusion is experimental and available only on Windows.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1"]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJCNURCMkVBNkNCQzVGRDkKUldUWlg3eHM2ckpkSzdwYTU1OVdFYWQ4NWN6cC8ydjdidHNWOHRPTldxOE0yWU9LYkxJYVYvdS8K",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
