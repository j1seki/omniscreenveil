{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniScreenVeil",
  "version": "0.1.0",
  "identifier": "dev.omniscreenveil.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OmniScreenVeil",
        "width": 1180,
        "height": 800,
        "minWidth": 940,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Selective screen-capture privacy",
    "longDescription": "Protect selected windows from screen capture. The Veil Surface masks protected windows in a shareable window on every platform; Windows additionally verifies OS-level capture exclusion.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1"]
      }
    }
  }
}
